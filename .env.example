# URL pública canónica del sitio (dominio técnico ASCII/Punycode).
# Usada como metadataBase y para construir URLs absolutas en
# sitemap.xml, robots.txt, canonical y JSON-LD.
SITE_URL=https://www.xn--berretn-dza.com.ar

# Activa la indexación real (robots.txt permitiendo el rastreo + meta
# robots "index, follow" en las páginas canónicas). Dejar sin definir o
# en "false" hasta que el dominio esté conectado y verificado — además
# solo tiene efecto en el deployment de producción, nunca en previews.
SITE_INDEXING_ENABLED=false

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Admin ---
ADMIN_EMAIL=

# --- Notificaciones administrativas por email (Resend) ---
# Activa/desactiva el envío. Sin esta variable en "true" (o sin el resto
# de las variables de Resend abajo), no se intenta enviar nada.
EMAIL_NOTIFICATIONS_ENABLED=false
# API key de Resend (dashboard → API Keys).
RESEND_API_KEY=
# Remitente verificado en Resend (requiere dominio/subdominio de envío
# verificado, ver README/instrucciones de deploy). Formato: "Nombre <cuenta@dominio>".
RESEND_FROM=
# A quién avisar cuando se guarda un aporte o un reporte nuevo.
ADMIN_NOTIFICATION_EMAIL=berretininfo@proton.me
